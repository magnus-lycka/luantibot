#!/bin/sh
# Boot a headless Luanti server on a disposable world, run the assertions in
# tests/integration/mods/luantibot_test, and report.
#
# The scratch world is destroyed and recreated on every run, on the sqlite3 map
# backend, so it is a throwaway file that never touches PostgreSQL or any world
# you care about.
#
# A fixed mapgen and seed keep its terrain deterministic, which the M2 and M6
# region comparisons depend on. Point MAPGEN and SEED at the world you actually
# build in and the terrain becomes representative of it too.
#
# Do not reach for `flat` or `singlenode`: the first crashes mineclonia's
# levelgen, the second hangs it during stronghold placement.
set -e

REPO_ROOT=$(cd "$(dirname "$0")/.." && pwd)

# Machine-specific settings live here, uncommitted. See scripts/local.env.example
if [ -f "$REPO_ROOT/scripts/local.env" ]; then
    . "$REPO_ROOT/scripts/local.env"
fi

LUANTI=${LUANTI:-$(command -v luantiserver || command -v luanti || echo luanti)}
GAMEID=${GAMEID:-mineclonia}
MAPGEN=${MAPGEN:-v7}
SEED=${SEED:-1}
TIMEOUT=${TIMEOUT:-120}

RUN_DIR="$REPO_ROOT/tests/integration/run"
WORLD="$RUN_DIR/world"
LOGFILE="$RUN_DIR/debug.txt"
RESULT="$WORLD/result.json"

if [ ! -x "$LUANTI" ]; then
    echo "luanti server binary not found: $LUANTI" >&2
    echo "Set LUANTI in scripts/local.env -- see scripts/local.env.example" >&2
    exit 1
fi

rm -rf "$RUN_DIR"
mkdir -p "$WORLD/worldmods"

cat > "$WORLD/world.mt" <<EOF
gameid = $GAMEID
backend = sqlite3
player_backend = sqlite3
auth_backend = sqlite3
mod_storage_backend = sqlite3
world_name = lbtest
load_mod_luantibot = true
load_mod_luantibot_test = true
EOF

# Do NOT hand-write map_meta.txt. A world created that way is missing every
# mapgen noise parameter, and games that read them back (mineclonia does) crash
# on nil during generation. Instead, set the mapgen in the config and let the
# engine write a complete map_meta.txt when it creates the world.
CONF="$RUN_DIR/server.conf"
cp "$REPO_ROOT/tests/integration/test.conf" "$CONF"
cat >> "$CONF" <<EOF

mg_name = $MAPGEN
fixed_map_seed = $SEED
EOF

ln -s "$REPO_ROOT/mods/luantibot" "$WORLD/worldmods/luantibot"
ln -s "$REPO_ROOT/tests/integration/mods/luantibot_test" "$WORLD/worldmods/luantibot_test"

# The builder service. From M1.4 the mod polls it, so the integration run
# exercises the whole path: mod -> HTTP -> service -> SQLite and back.
echo "starting builder service on 127.0.0.1:8080"
(cd "$REPO_ROOT" && uv run python -m luantibot.service \
    --db "$RUN_DIR/luantibot.sqlite" --port 8080) >"$RUN_DIR/service.log" 2>&1 &
SERVICE_PID=$!
trap 'kill "$SERVICE_PID" 2>/dev/null || true' EXIT

# Wait for it to accept connections before booting Luanti, or the mod's first
# poll fails and backs off, wasting most of the timeout budget.
waited=0
until curl -fsS "http://127.0.0.1:8080/v1/health" >/dev/null 2>&1; do
    if [ "$waited" -ge 30 ]; then
        echo "builder service did not start" >&2
        cat "$RUN_DIR/service.log" >&2
        exit 1
    fi
    sleep 1
    waited=$((waited + 1))
done

# Queue a job before the server boots. Nothing in-world triggers this: the mod
# must poll, fetch, execute and report entirely on its own. Submitting by world
# *name* also exercises adopt-by-name -- the mod registers afterwards under the
# same name and must attach to this row rather than fork a duplicate.
echo "submitting an emerge job"
JOB_ID=$(curl -fsS -X POST "http://127.0.0.1:8080/v1/jobs" \
    -H 'Content-Type: application/json' \
    -d '{"format":1,"world":"world",
         "bounds":{"min":[192,0,192],"max":[255,63,255]},
         "ops":[{"op":"emerge"}]}' | sed -n 's/.*"job_id":[ ]*\([0-9]*\).*/\1/p')
if [ -z "$JOB_ID" ]; then
    echo "failed to submit job" >&2
    cat "$RUN_DIR/service.log" >&2
    exit 1
fi
echo "queued job $JOB_ID"

echo "booting $GAMEID on $WORLD"
"$LUANTI" --server \
    --world "$WORLD" \
    --config "$CONF" \
    --logfile "$LOGFILE" \
    --gameid "$GAMEID" &
SERVER_PID=$!

# The test mod calls request_shutdown() when it is done, so a live process past
# the timeout means it hung rather than finished.
elapsed=0
while kill -0 "$SERVER_PID" 2>/dev/null; do
    if [ "$elapsed" -ge "$TIMEOUT" ]; then
        echo "TIMEOUT after ${TIMEOUT}s -- killing server" >&2
        kill -9 "$SERVER_PID" 2>/dev/null || true
        tail -30 "$LOGFILE" >&2 2>/dev/null || true
        exit 1
    fi
    sleep 1
    elapsed=$((elapsed + 1))
done

if [ ! -f "$RESULT" ]; then
    echo "server exited without writing $RESULT" >&2
    tail -40 "$LOGFILE" >&2 2>/dev/null || true
    exit 1
fi

echo "--- result ---"
cat "$RESULT"
echo

# The service's own view of the job, asserted from outside both processes.
JOB_ROW=$(curl -fsS "http://127.0.0.1:8080/v1/jobs/$JOB_ID" || echo '{}')
echo "--- job $JOB_ID ---"
echo "$JOB_ROW"
echo

FAILED=0
if grep -q '"failures": *0' "$RESULT" || grep -q '"failures":0' "$RESULT"; then
    echo "in-world assertions OK"
else
    echo "in-world assertions FAILED" >&2
    FAILED=1
fi

case "$JOB_ROW" in
    *'"state":"completed"'* | *'"state": "completed"'*)
        echo "job $JOB_ID completed"
        ;;
    *)
        echo "job $JOB_ID did not reach 'completed'" >&2
        FAILED=1
        ;;
esac

if [ "$FAILED" -eq 0 ]; then
    echo "integration OK"
    exit 0
fi

echo "integration FAILED" >&2
exit 1
