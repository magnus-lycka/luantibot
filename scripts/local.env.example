# Copy to scripts/local.env (gitignored) and edit for your machine.
# scripts/integration sources it if present, so nothing machine-specific has to
# be committed.

# Path to the Luanti server binary. Only needed if it is not on your PATH --
# for example a self-built macOS app bundle:
# LUANTI=$HOME/src/luanti/build/macos/luanti.app/Contents/MacOS/luanti

# Game to run the scratch world under.
# GAMEID=mineclonia

# Mapgen and seed for the scratch world. Set these to match the world you
# actually build in, and the integration terrain becomes representative of what
# the builder will really meet.
# MAPGEN=v7
# SEED=1

# Seconds before a run is treated as hung.
# TIMEOUT=120
